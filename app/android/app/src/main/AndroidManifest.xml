<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- 悬浮状态条（pill）：App 退后台时在屏幕上角显示链路状态。特殊权限，
         安装后默认关闭，需用户在系统设置里手动允许（App 内有引导入口）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- vc90 灭屏保活：任务等待/执行窗口的前台服务（specialUse 类型）。
         Android 13+ 通知可见性需要 POST_NOTIFICATIONS；未授权时服务照常运行，仅通知隐藏。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- vc92 灭屏保活：任务窗口内持 WifiLock，避免灭屏后 Wi-Fi 休眠导致 cloud poll 断流。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- 输入法中转打字（paste_text）：development 级权限，安装后必须一次性
         adb shell pm grant 授权；未授权时运行时降级报 ime_not_authorized。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <!-- Android 12+ 需要显式声明蓝牙权限；neverForLocation 表示不靠蓝牙推断位置，
         这样可以完全不申请定位权限，用户看到的风险提示也更少。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Android 11 及以下走旧权限模型 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <!-- 没装蓝牙的设备不提供安装 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

    <application
        android:label="手机控制助手"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher">
        <service android:name=".AccessibilityAssistService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="@string/accessibility_assist_label">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_assist"/>
        </service>
        <service android:name=".ScreenShareService" android:exported="false" android:foregroundServiceType="mediaProjection" android:stopWithTask="false"/>
        <!-- vc90 灭屏保活：任务等待/执行窗口内持 partial WakeLock 并前台运行，
             MIUI 等激进省电策略下灭屏也保持云端轮询与 USB 广播接收；窗口结束即退出。 -->
        <service android:name=".EngineKeepaliveService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="pcflash-task-keepalive"/>
        </service>
        <activity android:name=".VoicePermissionActivity" android:exported="false"
            android:taskAffinity="" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.Light.Dialog.Alert"/>
        <service android:name=".RelayImeService" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true" android:label="@string/relay_ime_label">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/relay_ime_method"/>
        </service>
        <activity android:name="org.example.phonecontroller.TaskWakeActivity" android:exported="false" android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:showWhenLocked="true" android:turnScreenOn="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".UsbAttachActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:noHistory="true"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter><action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/></intent-filter>
            <meta-data android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" android:resource="@xml/usb_board_filter"/>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService"/></intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
