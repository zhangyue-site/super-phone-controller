{
  "format": "phone-controller-plugin",
  "apiVersion": 1,
  "id": "demo.auto-bookkeeping",
  "name": "自动记账",
  "version": "1.0.0",
  "description": "读取支付宝消费账单，交给阿柴记账。",
  "runner": {
    "type": "server-workflow",
    "entry": "alipay-achai-consumption"
  },
  "parameters": {
    "until": "2026-09-10",
    "expenseOnly": true
  },
  "ui": {
    "running": {
      "title": "正在记账",
      "valueLabel": "当前核对金额",
      "value": "¥28.60",
      "status": "金额一致",
      "steps": [
        "打开",
        "核对",
        "保存",
        "返回"
      ],
      "note": "已记 12 / 跳过 3"
    },
    "duplicate": {
      "title": "已记过，自动跳过",
      "value": "¥18.00",
      "note": "正在返回账单列表"
    },
    "correction": {
      "title": "正在修正金额",
      "leftLabel": "列表金额",
      "leftValue": "¥28.60",
      "rightLabel": "识别金额",
      "rightValue": "¥28.80",
      "steps": [
        "取消",
        "修正",
        "再核对"
      ],
      "note": "核对一致后才保存"
    },
    "pending": {
      "title": "保存结果待核验",
      "value": "¥28.60",
      "note": "已提交，正在核对",
      "emphasis": "不会再次保存"
    },
    "complete": {
      "title": "本次处理完成",
      "note": "已记28笔 / 跳过6笔 / 待核0笔"
    }
  }
}